{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tethium-link",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "LINKS", "class_name": "LinkRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LinkRoom"] }
  ]
}
